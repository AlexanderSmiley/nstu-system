# Пример переменных окружения для docker-compose.
# Скопируйте в .env и обязательно замените все значения change-me на свои секреты:
#   cp .env.example .env
# Файл .env содержит секреты и не должен попадать в git (см. .gitignore).

# --- PostgreSQL ---
# Имя базы данных и учётные данные единой инсталляции PostgreSQL.
POSTGRES_DB=nstu
POSTGRES_USER=nstu
POSTGRES_PASSWORD=change-me

# --- RabbitMQ ---
# Учётные данные брокера сообщений (exchange nstu.events).
RABBITMQ_DEFAULT_USER=nstu
RABBITMQ_DEFAULT_PASS=change-me

# --- Безопасность ---
# Секрет подписи JWT (HS256). Минимум 32 байта случайных данных.
JWT_SECRET=change-me-generated-32-bytes-min
# Токен для внутренних вызовов между сервисами (заголовок X-Internal-Token).
INTERNAL_TOKEN=change-me
# Secure-флаг httpOnly cookie сессии. true обязателен, когда приложение доступно
# по HTTPS за reverse-proxy (NPM), даже если между NPM и контейнером трафик идёт
# по HTTP — иначе браузер не отправит cookie. Значение читает docker-compose.
COOKIE_SECURE=false

# --- Бутстрап администратора ---
# Первый администратор создаётся при старте auth-service. После первого входа
# система обяжет сменить пароль.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Маршруты gateway ---
# Адреса внутренних сервисов, к которым проксирует gateway. Значения ниже —
# docker-имена по умолчанию; менять только при нестандартной топологии.
NSTU_ROUTES_AUTH_URI=http://auth-service:8081
NSTU_ROUTES_STUDENT_URI=http://student-service:8082
NSTU_ROUTES_EVENT_URI=http://event-service:8083
NSTU_ROUTES_NOTIFICATION_URI=http://notification-service:8084

# --- CORS gateway ---
# Список разрешённых origin через запятую. Для продакшена за HTTPS обязательно
# укажите публичный адрес: NSTU_CORS_ALLOWED_ORIGINS=https://<домен>, иначе
# браузерные POST-запросы будут отбиваться 403 (same-origin проверка gateway).
NSTU_CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Прочее ---
# Название сайта по умолчанию (отображается на экране входа и в хедере).
SITE_NAME=NSTU System

# --- Публикация веб-морды ---
# Порт хоста, на котором отвечает frontend (SPA + прокси /api). Слушается только
# на loopback (127.0.0.1) — публичный доступ идёт через reverse-proxy.
WEB_PORT=8080

# --- Продакшн за Nginx Proxy Manager (NPM) ---
# Имя внешней docker-сети, в которой работает контейнер NPM. Используется
# override-файлом docker-compose.prod.yml: web подключается к этой сети с
# сетевым алиасом `nstu-web`. Узнать имя на сервере: `docker network ls`.
NPM_NETWORK=remnawave-network
# Для прод-развёртывания за HTTPS обязательно также:
#   COOKIE_SECURE=true
#   NSTU_CORS_ALLOWED_ORIGINS=https://<домен>
